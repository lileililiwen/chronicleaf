<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Chronicleaf.Application</RootNamespace>
    <AssemblyName>Chronicleaf.Application</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The GitHub transport (GITHUB-EVIDENCE-001/002). This is the same shape as the
      llm-provider-contract reference above and for the same reason: the read-only contract lives in
      its own leaf project that references nothing in this repository, and the service that owns the
      limits, the exclusions and the append is here. The reference is one way - nothing in
      Chronicleaf.GitHub depends on this assembly, so the transport can be replaced without any
      product code changing.
    -->
    <ProjectReference Include="../Chronicleaf.GitHub/Chronicleaf.GitHub.csproj" />
    <ProjectReference Include="../Chronicleaf.AI/Chronicleaf.AI.csproj" />
    <ProjectReference Include="../Chronicleaf.Core/Chronicleaf.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.4" />
    <!--
      The llm-provider-contract service logs identifiers, codes and durations for a bounded provider
      call - never evidence text and never a system instruction. That needs a logger interface in
      this project; the abstraction is the same one Infrastructure already references, so no new
      assembly enters the graph.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.4" />
  </ItemGroup>

</Project>
