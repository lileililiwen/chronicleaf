bin/
obj/
node_modules/
dist/
.env
.env.*
!.env.example
runtime/
media/

# Operator secrets. A key file is generated by the operator, lives outside the repository, and is
# mounted at run time; these patterns are here so a key that was written into the working tree by
# mistake is ignored rather than committed. scripts/e2e.sh and the tests write theirs under the
# operating system's temporary directory, which is already outside here.
*.key
*.pem
encryption.key
chronicleaf-encryption.key
*.user
TestResults/
playwright-report/
test-results/
