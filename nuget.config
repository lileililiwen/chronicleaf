<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Ruling 12 of the workspace ARCHITECTURE.md: a consumer must never depend on a machine-specific
    path and must still restore on CI where the dotnet-platform-libs checkout does not exist.

    The feed is therefore a repo-relative directory holding the .nupkg files that are committed
    alongside this file, so a fresh clone restores with no sibling checkout, no credential and no
    environment variable. The environment-variable form is rejected on purpose: an env var a CI
    runner does not have is the same failure class as a hard-coded absolute path.

    scripts/pack-platform.sh re-packs the feed from a checked-out sibling and is the ONLY place a
    sibling path may appear. It is a maintenance tool; nothing in the build path calls it.
  -->
  <packageSources>
    <clear />
    <add key="chronicleaf-platform-feed" value="packages/platform-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
